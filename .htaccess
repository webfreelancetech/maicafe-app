<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /maicafe-app/
    
    # Skip if already in public folder
    RewriteCond %{REQUEST_URI} ^/maicafe-app/maicafe-app/public
    RewriteRule ^ - [L]
    
    # Internal rewrite to Laravel public folder (preserves POST method)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ maicafe-app/public/$1 [L]
</IfModule>

